# Local development credentials only. Do not commit .env.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
POSTGRES_USER=trivia
POSTGRES_PASSWORD=trivia_local
POSTGRES_DB=trivia
POSTGRES_PORT=5432
# Native Node uses localhost; Compose injects the internal postgres hostname.
DATABASE_URL=postgresql://trivia:trivia_local@127.0.0.1:5432/trivia
