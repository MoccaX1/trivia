# Local development credentials only. Do not commit .env.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
POSTGRES_USER=trivia
POSTGRES_PASSWORD=trivia_local
POSTGRES_DB=trivia
POSTGRES_PORT=5432
# Backend URLs are complete and authoritative; PG* variables are not used.
# Percent-encode username, password, and database components independently.
# Single-quote raw provisioning values containing #, $, or spaces.
# Native Node uses localhost; Compose uses its internal postgres hostname.
DATABASE_URL=postgresql://trivia:trivia_local@127.0.0.1:5432/trivia
COMPOSE_DATABASE_URL=postgresql://trivia:trivia_local@postgres:5432/trivia

# Native loopback development only (never production or a non-loopback peer).
AUTH_COOKIE_MODE=loopback
AUTH_PUBLIC_ORIGIN=http://127.0.0.1:3000
AUTH_ORIGINS=http://127.0.0.1:3000
# Secure deployments require HTTPS origins and an explicit trusted proxy IP/CIDR
# when TLS is terminated before Fastify. Never use blanket trust.
# AUTH_COOKIE_MODE=secure
# AUTH_PUBLIC_ORIGIN=https://<your-api-host>
# AUTH_ORIGINS=https://<your-approved-same-site-browser-origin>
# AUTH_TRUST_PROXY=<your-proxy-ip-or-cidr>
