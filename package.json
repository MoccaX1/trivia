{
  "name": "trivia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "migrate": "npm run build && node --env-file-if-exists=.env scripts/migrate.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "release": "release-it",
    "release:dry-run": "node scripts/check-release-tree.mjs && release-it --dry-run --ci"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "fastify": "^5.12.6",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "tldts": "7.4.19"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "release-it": "21.1.2",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "6.2.3"
    }
  }
}
